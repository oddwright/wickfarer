; Engine configuration file.
config_version=5

[application]

config/name="Wickfarer"
config/description="Phase 0 combat prototype"
config/icon="res://art/icon_1024.png"
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.031, 0.031, 0.102, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=2400
window/size/viewport_height=1080
window/size/window_width_override=1200
window/size/window_height_override=540
window/stretch/mode="disabled"
window/handheld/orientation=6
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[internationalization]

locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.031, 0.031, 0.102, 1)
